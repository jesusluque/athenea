<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!--
    UsdPreviewSurface as the engine reads it. MaterialX's own nodegraph
    (libraries/bxdf/usd_preview_surface.mtlx) makes a fractional opacity a
    dielectric transmission lobe at the surface's ior -- glass -- and a sphere
    of opacity 0 came out a grey lens of the sky where Storm draws nothing.
    USD's opacity is coverage: the surface is there or it is not, so here the
    lobes are the opaque surface's and `opacity` goes out as the surface's
    opacity, for the passes and the path tracer to cut by (stochastically,
    where it is fractional). The lobes are MaterialX's graph's, built by one
    node (athenea_preview_bsdf) where the graph passed a dozen BSDF values.
  -->
  <nodedef name="ND_athenea_preview_bsdf" node="athenea_preview_bsdf" nodegroup="pbr">
    <input name="diffuseColor" type="color3" value="0.18, 0.18, 0.18" />
    <input name="useSpecularWorkflow" type="float" value="0" />
    <input name="specularColor" type="color3" value="0, 0, 0" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="vector2" value="0.5, 0.5" />
    <input name="clearcoat" type="float" value="0" />
    <input name="clearcoatRoughness" type="vector2" value="0.01, 0.01" />
    <input name="ior" type="float" value="1.5" />
    <input name="metalIor" type="color3" value="0, 0, 0" />
    <input name="metalExtinction" type="color3" value="0, 0, 0" />
    <input name="normal" type="vector3" defaultgeomprop="Nworld" />
    <input name="tangent" type="vector3" defaultgeomprop="Tworld" />
    <output name="out" type="BSDF" />
  </nodedef>
  <implementation name="IM_athenea_preview_bsdf_genslang" nodedef="ND_athenea_preview_bsdf" file="athenea/material/mx/athenea_preview_bsdf.slang" function="athenea_preview_bsdf" target="genslang" />

  <nodegraph name="IMP_UsdPreviewSurface_surfaceshader" nodedef="ND_UsdPreviewSurface_surfaceshader">

    <convert name="use_specular_workflow_float" type="float">
      <input name="in" type="integer" interfacename="useSpecularWorkflow" />
    </convert>

    <!-- Compute the surface normal -->
    <multiply name="scale_normal" type="vector3">
      <input name="in1" type="vector3" interfacename="normal" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="bias_normal" type="vector3">
      <input name="in1" type="vector3" nodename="scale_normal" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <normalmap name="surface_normal" type="vector3">
      <input name="in" type="vector3" nodename="bias_normal" />
    </normalmap>

    <!-- The lobes: MaterialX's diffuse, specular and metalness workflows and
         clearcoat, as one node (athenea_preview_bsdf.slang says why). -->
    <roughness_anisotropy name="specular_roughness" type="vector2">
      <input name="roughness" type="float" interfacename="roughness" />
      <input name="anisotropy" type="float" value="0" />
    </roughness_anisotropy>
    <roughness_anisotropy name="coat_roughness" type="vector2">
      <input name="roughness" type="float" interfacename="clearcoatRoughness" />
      <input name="anisotropy" type="float" value="0" />
    </roughness_anisotropy>
    <artistic_ior name="artistic_ior" type="multioutput">
      <input name="reflectivity" type="color3" interfacename="diffuseColor" />
      <input name="edge_color" type="color3" interfacename="diffuseColor" />
    </artistic_ior>
    <athenea_preview_bsdf name="coat_bsdf" type="BSDF">
      <input name="diffuseColor" type="color3" interfacename="diffuseColor" />
      <input name="useSpecularWorkflow" type="float" nodename="use_specular_workflow_float" />
      <input name="specularColor" type="color3" interfacename="specularColor" />
      <input name="metallic" type="float" interfacename="metallic" />
      <input name="roughness" type="vector2" nodename="specular_roughness" />
      <input name="clearcoat" type="float" interfacename="clearcoat" />
      <input name="clearcoatRoughness" type="vector2" nodename="coat_roughness" />
      <input name="ior" type="float" interfacename="ior" />
      <input name="metalIor" type="color3" nodename="artistic_ior" output="ior" />
      <input name="metalExtinction" type="color3" nodename="artistic_ior" output="extinction" />
      <input name="normal" type="vector3" nodename="surface_normal" />
    </athenea_preview_bsdf>

    <!-- Emission Layer -->
    <uniform_edf name="emission_edf" type="EDF">
      <input name="color" type="color3" interfacename="emissiveColor" />
    </uniform_edf>

    <!-- Surface Shader Constructor -->
    <ifgreatereq name="cutout_opacity" type="float">
      <input name="value1" type="float" interfacename="opacity" />
      <input name="value2" type="float" interfacename="opacityThreshold" />
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" value="0" />
    </ifgreatereq>
    <ifgreater name="opacity_presence" type="float">
      <input name="value1" type="float" interfacename="opacityThreshold" />
      <input name="value2" type="float" value="0" />
      <input name="in1" type="float" nodename="cutout_opacity" />
      <input name="in2" type="float" interfacename="opacity" />
    </ifgreater>
    <surface name="surface_constructor" type="surfaceshader">
      <input name="bsdf" type="BSDF" nodename="coat_bsdf" />
      <input name="edf" type="EDF" nodename="emission_edf" />
      <input name="opacity" type="float" nodename="opacity_presence" />
    </surface>

    <!-- Output -->
    <output name="out" type="surfaceshader" nodename="surface_constructor" />
  </nodegraph>
</materialx>
