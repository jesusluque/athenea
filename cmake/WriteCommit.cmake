#
# Writes OUT, a header defining ATHENEA_COMMIT as `git describe --always
# --dirty` of SOURCE: what `athenea flatten` records of the build that made a
# file. Run at every build; the header is rewritten only when the commit
# changed, so nothing that includes it is rebuilt for nothing.
execute_process(
    COMMAND git -C "${SOURCE}" describe --always --dirty --abbrev=12
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE failed)
if(failed OR commit STREQUAL "")
    set(commit "unknown")
endif()
set(text "// Generated by cmake/WriteCommit.cmake.\n#pragma once\n#define ATHENEA_COMMIT \"${commit}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" before)
    if(before STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
