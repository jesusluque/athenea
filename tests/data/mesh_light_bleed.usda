#usda 1.0
# Copyright (c) 2026 jesus luque.
(
    defaultPrim = "World"
    subLayers = [@./lobes/sphere.usda@, @./tx/ground.usda@]
    upAxis = "Y"
)
# A white ball on a red floor beside a strip of mesh light in emission group
# `strip`, and nothing else lit: the light the floor bounces onto the ball is
# red. Converted with `athenea mesh2splat --transfer --light-groups strip`
# (ctest's mesh2splat_light_groups), the cloud carries that bounce as a
# layer, which tests/usd/test_mesh_lights_bake.cpp draws against the mesh
# path traced.
over "World"
{
    over "Sky" (
        active = false
    )
    {
    }

    over "Sun" (
        active = false
    )
    {
    }

    over "Ground"
    {
        color3f[] primvars:displayColor = [(0.7, 0.12, 0.08)] (
            interpolation = "constant"
        )
    }

    def Scope "Looks"
    {
        def Material "Surface"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Surface/OpenPBR.outputs:out>

            def Shader "OpenPBR"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.8, 0.8)
                float inputs:specular_roughness = 0.6
                token outputs:out
            }
        }
    }

    def Mesh "Strip" (
        prepend apiSchemas = ["MeshLightAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1.3, 0.6, -1), (1.9, 0.6, -1), (1.9, 0.6, 1), (1.3, 0.6, 1)]
        uniform token subdivisionScheme = "none"
        string primvars:athenea:lightGroup = "strip" (
            interpolation = "constant"
        )
        float inputs:intensity = 6
        color3f inputs:color = (1, 0.9, 0.8)
    }
}
