#usda 1.0
# Copyright (c) 2026 jesus luque.
(
    defaultPrim = "World"
    subLayers = [@./sphere.usda@]
    upAxis = "Y"
)
# Chrome: a bright metal, nearly a mirror. OpenPBR.
over "World"
{
    def Scope "Looks"
    {
        def Material "Surface"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Surface/OpenPBR.outputs:out>

            def Shader "OpenPBR"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.8, 0.8)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.1
                token outputs:out
            }
        }
    }
}
