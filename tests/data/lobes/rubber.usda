#usda 1.0
# Copyright (c) 2026 jesus luque.
(
    defaultPrim = "World"
    subLayers = [@./sphere.usda@]
    upAxis = "Y"
)
# Rubber: a black dielectric, rough, at 1.45, with the bloom of a sheen. OpenPBR.
over "World"
{
    def Scope "Looks"
    {
        def Material "Surface"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Surface/OpenPBR.outputs:out>

            def Shader "OpenPBR"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.02, 0.02, 0.02)
                float inputs:specular_roughness = 0.6
                float inputs:specular_ior = 1.45
                float inputs:sheen_weight = 0.5
                color3f inputs:sheen_color = (1, 1, 1)
                float inputs:sheen_roughness = 0.5
                token outputs:out
            }
        }
    }
}
