#usda 1.0
# Copyright (c) 2026 jesus luque.
(
    defaultPrim = "World"
    subLayers = [@./sphere.usda@]
    upAxis = "Y"
)
# Plastic: a red dielectric whose specular is weighed down and tinted. OpenPBR.
over "World"
{
    def Scope "Looks"
    {
        def Material "Surface"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Surface/OpenPBR.outputs:out>

            def Shader "OpenPBR"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.6, 0.08, 0.06)
                float inputs:specular_roughness = 0.25
                float inputs:specular_weight = 0.7
                color3f inputs:specular_color = (1, 0.9, 0.8)
                token outputs:out
            }
        }
    }
}
