#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
# The same quad with its light read off a map: glTF's `emissive` connected to
# a gradient (emission_gradient.png, sRGB), times `emissive_strength` 2. What
# a gaussian carries is the strength times the texel it stands on.
def Xform "World"
{
    def Mesh "Quad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Screen>
    }

    def Scope "Looks"
    {
        def Material "Screen"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Screen/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.5, 0.5, 0.5)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:emissive.connect = </World/Looks/Screen/Picture.outputs:out>
                float inputs:emissive_strength = 2
                token outputs:out
            }

            def Shader "Picture"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./emission_gradient.png@ (
                    colorSpace = "srgb_texture"
                )
                color3f outputs:out
            }
        }
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.1
    }
}
