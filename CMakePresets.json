{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SLANG_ROOT": "$env{HOME}/tools/slang",
        "ATHENEA_USD_ROOT": "$env{HOME}/tools/usd-26.08-mx",
        "ATHENEA_OIDN_ROOT": "$env{HOME}/tools/oidn-2.5.1"
      }
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "base",
      "displayName": "macOS arm64 Debug (Metal)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "base",
      "displayName": "macOS arm64 Release (Metal)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "linux-x86_64-debug",
      "inherits": "base",
      "displayName": "Linux x86_64 Debug (CUDA/Vulkan)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x86_64-release",
      "inherits": "base",
      "displayName": "Linux x86_64 Release (CUDA/Vulkan)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "SLANG_ROOT": "D:/tools/slang",
        "ATHENEA_USD_ROOT": "D:/tools/usd-26.08-mx",
        "ATHENEA_OIDN_ROOT": "D:/tools/oidn-2.5.1",
        "ATHENEA_OCIO_ROOT": "D:/tools/ocio-2.5.2",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_PREFIX_PATH": "D:/tools/usd-26.08-mx"
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-base",
      "displayName": "Windows x64 Debug (CUDA)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release (CUDA)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "SLANG_ROOT": "$env{HOME}/tools/ios/slang-2026.14.1",
        "ATHENEA_USD_ROOT": "$env{HOME}/tools/ios/usd-26.08-mx",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "ios-arm64-debug",
      "inherits": "ios-base",
      "displayName": "iOS arm64 Debug (Metal)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ios-arm64-release",
      "inherits": "ios-base",
      "displayName": "iOS arm64 Release (Metal)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-arm64-blender",
      "inherits": "base",
      "displayName": "macOS arm64 hdAthenea for Blender (Metal)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "ATHENEA_USD_ROOT": "$env{HOME}/tools/usd-26.08-blender",
        "ATHENEA_BLENDER_LIB": "/Applications/Blender.app/Contents/Resources/lib",
        "ATHENEA_NANOVDB_INCLUDE": "$env{HOME}/tools/usd-26.08-mx/include",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "linux-x86_64-blender",
      "inherits": "base",
      "displayName": "Linux x86_64 hdAthenea for Blender (CUDA/Vulkan)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ATHENEA_USD_ROOT": "$env{HOME}/tools/usd-26.08-blender",
        "ATHENEA_BLENDER_LIB": "$env{BLENDER_LIB}",
        "ATHENEA_NANOVDB_INCLUDE": "$env{HOME}/tools/usd-26.08-mx/include",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "windows-x64-blender",
      "inherits": "windows-base",
      "displayName": "Windows x64 hdAthenea for Blender (CUDA/Vulkan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ATHENEA_USD_ROOT": "D:/tools/usd-26.08-blender",
        "CMAKE_PREFIX_PATH": "D:/tools/usd-26.08-blender;D:/tools/usd-26.08-mx",
        "ATHENEA_BLENDER_LIB": "$env{BLENDER_DIR}/blender.shared",
        "ATHENEA_NANOVDB_INCLUDE": "D:/tools/usd-26.08-mx/include",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "linux-x86_64-debug",
      "configurePreset": "linux-x86_64-debug"
    },
    {
      "name": "linux-x86_64-release",
      "configurePreset": "linux-x86_64-release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "ios-arm64-debug",
      "configurePreset": "ios-arm64-debug"
    },
    {
      "name": "ios-arm64-release",
      "configurePreset": "ios-arm64-release"
    },
    {
      "name": "macos-arm64-blender",
      "configurePreset": "macos-arm64-blender",
      "targets": [
        "hdAthenea",
        "athenea_shaders_copy",
        "athenea_aofx_mesh2splat",
        "athenea_aofx_splatbakefilter",
        "athenea_aofx_measure",
        "athenea_aofx_splattransferzonal"
      ]
    },
    {
      "name": "linux-x86_64-blender",
      "configurePreset": "linux-x86_64-blender",
      "targets": [
        "hdAthenea",
        "athenea_shaders_copy",
        "athenea_aofx_mesh2splat",
        "athenea_aofx_splatbakefilter",
        "athenea_aofx_measure",
        "athenea_aofx_splattransferzonal"
      ]
    },
    {
      "name": "windows-x64-blender",
      "configurePreset": "windows-x64-blender",
      "targets": [
        "hdAthenea",
        "athenea_shaders_copy",
        "athenea_aofx_mesh2splat",
        "athenea_aofx_splatbakefilter",
        "athenea_aofx_measure",
        "athenea_aofx_splattransferzonal"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "linux-x86_64-debug",
      "configurePreset": "linux-x86_64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "linux-x86_64-release",
      "configurePreset": "linux-x86_64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
